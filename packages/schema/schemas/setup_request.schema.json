{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setup_request.schema.json",
  "title": "SetupRequest",
  "description": "payload of a `setup_assistant` row in pending_live_requests: the whole conversation so far (the app keeps it; each row is one turn).",
  "type": "object",
  "additionalProperties": false,
  "required": ["messages"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
