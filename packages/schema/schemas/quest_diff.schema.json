{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quest_diff.schema.json",
  "title": "QuestDiff",
  "description": "What a model proposes against the current quest log. The user accepts or rejects each op; the model never writes quests directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ops"],
  "properties": {
    "ops": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/QuestOp" }
    },
    "summary": { "type": ["string", "null"], "maxLength": 500 }
  },
  "$defs": {
    "QuestOp": {
      "discriminator": { "propertyName": "op" },
      "oneOf": [
        { "$ref": "#/$defs/AddOp" },
        { "$ref": "#/$defs/UpdateOp" },
        { "$ref": "#/$defs/DropOp" }
      ]
    },
    "QuestDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "persona", "cadence", "category", "estimate_min", "priority"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "notes": { "type": ["string", "null"], "maxLength": 2000 },
        "persona": { "$ref": "common.schema.json#/$defs/PersonaSlug" },
        "cadence": { "$ref": "common.schema.json#/$defs/Cadence" },
        "category": { "$ref": "common.schema.json#/$defs/Category" },
        "estimate_min": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "scheduled_for": { "type": ["string", "null"], "format": "date" },
        "deadline": { "type": ["string", "null"], "format": "date-time" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "parent_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "QuestChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "notes": { "type": ["string", "null"], "maxLength": 2000 },
        "persona": { "$ref": "common.schema.json#/$defs/PersonaSlug" },
        "estimate_min": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "scheduled_for": { "type": ["string", "null"], "format": "date" },
        "deadline": { "type": ["string", "null"], "format": "date-time" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "AddOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "quest", "reason"],
      "properties": {
        "op": { "const": "add" },
        "quest": { "$ref": "#/$defs/QuestDraft" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "UpdateOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "quest_id", "changes", "reason"],
      "properties": {
        "op": { "const": "update" },
        "quest_id": { "type": "string", "format": "uuid" },
        "changes": { "$ref": "#/$defs/QuestChanges" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "DropOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "quest_id", "reason"],
      "properties": {
        "op": { "const": "drop" },
        "quest_id": { "type": "string", "format": "uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
