# Public client config for the Supabase project (anon key is safe to ship; RLS guards data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Web Push public key from `python -m runner vapid` (optional; hides the toggle when unset).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
