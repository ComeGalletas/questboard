{
  "name": "@questboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings 'src/**/*.test.ts'",
    "icons": "python3 scripts/make-icons.py",
    "personas": "node scripts/build-personas.mjs",
    "predev": "node scripts/build-personas.mjs",
    "prebuild": "node scripts/build-personas.mjs",
    "pretypecheck": "node scripts/build-personas.mjs",
    "pretest": "node scripts/build-personas.mjs"
  },
  "dependencies": {
    "@questboard/schema": "workspace:*",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
